# Copy to .env on the VPS, then chmod 600 .env. Never commit .env.
# Confenge-maintained Quickly v2.4.0 image. Replace the placeholder with the
# immutable digest produced by the "Confenge GHCR image" workflow; never use
# a floating tag in the VPS .env.
QUICKLY_IMAGE=ghcr.io/tjsasakifln/quickly-confenge@sha256:REPLACE_WITH_GHCR_IMAGE_DIGEST
BASE_URL=https://campanhas.confenge.com.br
CORS_ORIGINS=https://campanhas.confenge.com.br
POSTGRES_DB=quickly
POSTGRES_USER=quickly
POSTGRES_PASSWORD=REPLACE_WITH_A_URLSAFE_RANDOM_DATABASE_PASSWORD
QUICKLY_SECRET_KEY=REPLACE_WITH_A_STABLE_RANDOM_64_BYTE_URLSAFE_SECRET
QUICKLY_ENCRYPTION_KEY=REPLACE_WITH_A_STABLE_FERNET_KEY

# Used only by scripts/bootstrap-admin.sh; delete these two lines after bootstrap.
QUICKLY_BOOTSTRAP_ADMIN_USERNAME=tiago.sasaki
QUICKLY_BOOTSTRAP_ADMIN_EMAIL=tiago.sasaki@confenge.com.br
QUICKLY_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_URLSAFE_STRONG_PANEL_PASSWORD

# SMTP/IMAP credentials are intentionally NOT environment variables. Add the
# Hostinger mailbox through Quickly's Inboxes UI after the admin exists.
